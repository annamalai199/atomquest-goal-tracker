# Environment Variables Example
# Copy this file to .env.local and fill in your values

# Database Configuration (Required)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require&connect_timeout=30&pool_timeout=30&connection_limit=5"
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require&connect_timeout=30"

# NextAuth Configuration (Required)
# For development: Leave NEXTAUTH_URL empty (auto-detects port)
# For production: Set to your actual domain (e.g., https://yourdomain.com)
NEXTAUTH_URL=
NEXTAUTH_SECRET=atomquest-super-secret-key-change-in-production-min-32-chars

# JWT Secret (Required)
JWT_SECRET=atomquest-jwt-secret-key-change-in-production-min-32-chars

# API Configuration
NEXT_PUBLIC_API_URL=https://api.atomberg.com
NEXT_PUBLIC_APP_URL=https://atomberg.com

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Feature Flags
NEXT_PUBLIC_ENABLE_CHAT=false
NEXT_PUBLIC_ENABLE_NEWSLETTER=true
